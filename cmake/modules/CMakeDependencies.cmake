#############################################################
##################### Logging functions #####################
#############################################################

function(status)
    cmake_parse_arguments(PARSE_ARGV 0
        "LOG"
        "ERROR;WARN;INFO"
        "MESSAGE;OUTPUT;PREFIX"
        ""
    )

    string(ASCII 27 ESC)

    if(NOT DEFINED LOG_TYPE)
        set(LOG_TYPE "INFO")
    endif()

    if($ENV{COLORTERM} MATCHES "(truecolor|24bit|24-bit)" OR CMAKE_HOST_WIN32)
        set(COLOR_SUPPORT "truecolor")
    else()
        set(COLOR_SUPPORT "standard")
    endif()

    if(COLOR_SUPPORT STREQUAL truecolor)
        set(INFO_COLOR "${ESC}[38;2;43;136;221m")
        set(WARN_COLOR "${ESC}[38;2;157;24;216m")
        set(ERROR_COLOR "${ESC}[38;2;221;43;43m")
    elseif(COLOR_SUPPORT STREQUAL standard)
        set(INFO_COLOR "${ESC}[36m")
        set(WARN_COLOR "${ESC}[35m")
        set(ERROR_COLOR "${ESC}[31m")
    endif()

    if(DEFINED LOG_PREFIX AND NOT LOG_PREFIX MATCHES " $")
        set(LOG_PREFIX "${LOG_PREFIX} ")
    endif()

    if(LOG_ERROR)
        if(DEFINED LOG_OUTPUT)
            set(${LOG_OUTPUT} "${ERROR_COLOR}${LOG_PREFIX}ERROR:${ESC}[0m ${LOG_MESSAGE}" PARENT_SCOPE)
        else()
            message(FATAL_ERROR "${LOG_MESSAGE}")
        endif()
    elseif(LOG_WARN)
        if(DEFINED LOG_OUTPUT)
            set(${LOG_OUTPUT} "${WARN_COLOR}${LOG_PREFIX}WARN:${ESC}[0m ${LOG_MESSAGE}" PARENT_SCOPE)
        else()
            message(STATUS "${WARN_COLOR}${LOG_PREFIX}WARN:${ESC}[0m ${LOG_MESSAGE}")
        endif()
    elseif(LOG_INFO)
        if(DEFINED LOG_OUTPUT)
            set(${LOG_OUTPUT} "${INFO_COLOR}${LOG_PREFIX}INFO:${ESC}[0m ${LOG_MESSAGE}" PARENT_SCOPE)
        else()
            message(STATUS "${INFO_COLOR}${LOG_PREFIX}INFO:${ESC}[0m ${LOG_MESSAGE}")
        endif()
    endif()

    return()
endfunction()

#############################################################
####################### URL functions #######################
#############################################################

function(get_url_type)
    cmake_parse_arguments(PARSE_ARGV 0
        ""
        ""
        "URL;OUTPUT"
        ""
    )

    if(_URL MATCHES ^https://github.com OR _URL MATCHES ^git@github.com)
        set(${_OUTPUT} Github PARENT_SCOPE)
    else()
        set(${_OUTPUT} Custom PARENT_SCOPE)
    endif()

    return()
endfunction()

function(fetch_url)
    cmake_parse_arguments(PARSE_ARGV 0
        "FETCH"
        ""
        "URL;ID;DESTINATION"
        ""
    )

    if(NOT DEFINED FETCH_URL)
        status(ERROR MESSAGE "Must specify a URL to be fetched" PREFIX FETCH)
    endif()

    if(NOT DEFINED FETCH_ID)
        status(ERROR MESSAGE "Must specify a URL ID to be able to fetch a URL" PREFIX FETCH)
    endif()

    if(NOT DEFINED FETCH_DESTINATION)
        status(ERROR MESSAGE "Must specify a destination to place the fetched artifact" PREFIX FETCH)
    endif()

    get_url_type(URL "${FETCH_URL}" OUTPUT URL_TYPE)

    if(URL_TYPE STREQUAL Github)
        find_program(GIT_COMMAND NAMES git)

        if(GIT_COMMAND STREQUAL GIT_COMMAND-NOTFOUND)
            status(ERROR MESSAGE "Unable to find 'git'. Please install it to use Github dependencies")
        endif()

        if(EXISTS ${FETCH_DESTINATION})
            status(WARN MESSAGE "Removing directory at ${FETCH_DESTINATION}" PREFIX FETCH)
            file(REMOVE_RECURSE "${FETCH_DESTINATION}")
        endif()

        execute_process(
            COMMAND ${GIT_COMMAND} -c advice.detachedHead=false clone
            -q --separate-git-dir=${CMAKE_DEPENDENCY_STAGE}/.tmp
            --depth=1 --recurse-submodules --shallow-submodules --single-branch
            --branch ${FETCH_ID}
            ${FETCH_URL} ${FETCH_DESTINATION}
            OUTPUT_QUIET
            ERROR_VARIABLE GIT_ERROR
        )

        if(GIT_ERROR)
            status(ERROR MESSAGE "${GIT_ERROR}" PREFIX FETCH)
        endif()

        file(REMOVE_RECURSE ${CMAKE_DEPENDENCY_STAGE}/.git ${CMAKE_DEPENDENCY_STAGE}/.tmp)
    elseif(URL_TYPE STREQUAL Custom)
        status(ERROR MESSAGE "Custom URLs are currently not supported" PREFIX FETCH)
    else()
        status(ERROR MESSAGE "Unknown URL type for URL '${FETCH_URL}'" PREFIX FETCH)
    endif()

    return()
endfunction()

#############################################################
##################### Locking functions #####################
#############################################################

function(make_lockfile_hash)
    cmake_parse_arguments(PARSE_ARGV 1
        "LOCK"
        ""
        "URL;OUTPUT"
        ""
    )

    string(SHA512 ${LOCK_OUTPUT} "${LOCK_URL}")

    return(PROPAGATE ${LOCK_OUTPUT})
endfunction()

function(compare_lockfile_values DEPENDENCY)
    cmake_parse_arguments(PARSE_ARGV 1
        "LOCK"
        "HASH;SYSTEM;OPTIONS;CONFIGURATION"
        "OUTPUT;"
        ""
    )

    if(LOCK_HASH)
        list(APPEND CHECKS HASH)
    endif()

    if(LOCK_SYSTEM)
        list(APPEND CHECKS SYSTEM)
    endif()

    if(LOCK_CONFIGURATION)
        list(APPEND CHECKS CONFIGURATION)
    endif()

    if(LOCK_OPTIONS)
        list(APPEND CHECKS OPTIONS)
    endif()

    if(LOCK_HASH)
        make_lockfile_hash(${DEPENDENCY} OUTPUT DEPENDENCY_HASH)
    endif()

    foreach(CHECK IN LISTS CHECKS)
        if(NOT ${DEPENDENCY}_${CHECK} AND NOT DEPENDENCY_${CHECK})
            continue()
        elseif(NOT ${DEPENDENCY}_${CHECK} STREQUAL DEPENDENCY_${CHECK})
            set(${LOCK_OUTPUT} ON)
            break()
        endif()
    endforeach()

    if(NOT DEFINED ${LOCK_OUTPUT})
        set(${LOCK_OUTPUT} OFF)
    endif()

    return(PROPAGATE ${LOCK_OUTPUT})
endfunction()

function(update_lockfile DEPENDENCY)
    cmake_parse_arguments(PARSE_ARGV 1
        "LOCK"
        ""
        "URL;HASH;CONFIGURATION;SYSTEM"
        "OPTIONS;EXPORTS"
    )

    if(DEFINED LOCK_URL)
        make_lockfile_hash(URL ${LOCK_URL} OUTPUT LOCK_HASH)
    endif()

    if(NOT EXISTS ${CMAKE_LOCKFILE})
        file(TOUCH ${CMAKE_LOCKFILE})
        file(CHMOD ${CMAKE_LOCKFILE} PERMISSIONS
            OWNER_READ
            GROUP_READ
            WORLD_READ
        )

        if(DEFINED LOCK_HASH)
            file(APPEND ${CMAKE_LOCKFILE} "set(${DEPENDENCY}_HASH \"${LOCK_HASH}\")") 
        endif()

        if(DEFINED LOCK_SYSTEM)
            file(APPEND ${CMAKE_LOCKFILE} "set(${DEPENDENCY}_SYSTEM \"${LOCK_SYSTEM}\")")
        endif()

        if(DEFINED LOCK_CONFIGURATION)
            file(APPEND ${CMAKE_LOCKFILE} "set(${DEPENDENCY}_CONFIGURATION \"${LOCK_CONFIGURATION}\")")
        endif()

        if(DEFINED LOCK_OPTIONS)
            list(JOIN LOCK_OPTIONS " " OPTIONS)
            file(APPEND ${CMAKE_LOCKFILE} "set(${DEPENDENCY}_OPTIONS ${OPTIONS})")
        endif()

        if(DEFINED LOCK_EXPORTS)
            list(JOIN LOCK_EXPORTS " " EXPORTS)
            string(REPLACE "${CMAKE_DEPENDENCY_DESTINATION}/" "" EXPORTS "${EXPORTS}")
            file(APPEND ${CMAKE_LOCKFILE} "set(${DEPENDENCY}_EXPORTS ${EXPORTS})")
        endif()
    else()
        file(READ ${CMAKE_LOCKFILE} LOCKFILE)

        if(DEFINED LOCK_HASH)
            if(LOCKFILE MATCHES "set\\(${DEPENDENCY}_HASH .*\\)")
                string(REGEX REPLACE
                    "${DEPENDENCY}_HASH [^)]*" "${DEPENDENCY}_HASH \"${LOCK_HASH}\""
                    LOCKFILE "${LOCKFILE}"
                )
            else()
                set(LOCKFILE "${LOCKFILE}\nset(${DEPENDENCY}_HASH \"${LOCK_HASH}\")")
            endif()
        endif()

        if(DEFINED LOCK_SYSTEM)
            if(LOCKFILE MATCHES "set\\(${DEPENDENCY}_SYSTEM .*\\)")
                string(REGEX REPLACE
                    "${DEPENDENCY}_SYSTEM [^)]*" "${DEPENDENCY}_SYSTEM \"${LOCK_SYSTEM}\""
                    LOCKFILE "${LOCKFILE}"
                )
            else()
                set(LOCKFILE "${LOCKFILE}\nset(${DEPENDENCY}_SYSTEM \"${LOCK_SYSTEM}\")")
            endif()
        endif()

        if(DEFINED LOCK_CONFIGURATION)
            if(LOCKFILE MATCHES "set\\(${DEPENDENCY}_CONFIGURATION .*\\)")
                string(REGEX REPLACE
                    "${DEPENDENCY}_CONFIGURATION [^)]*"
                    "${DEPENDENCY}_CONFIGURATION \"${LOCK_CONFIGURATION}\""
                    LOCKFILE "${LOCKFILE}"
                )
            else()
                set(LOCKFILE "${LOCKFILE}\nset(${DEPENDENCY}_CONFIGURATION \"${LOCK_CONFIGURATION}\")")
            endif()
        endif()

        if(DEFINED LOCK_OPTIONS)
            list(JOIN LOCK_OPTIONS " " OPTIONS)
            if(LOCKFILE MATCHES "set\\(${DEPENDENCY}_OPTIONS .*\\)")
                string(REGEX REPLACE
                    "${DEPENDENCY}_OPTIONS [^)]*" "${DEPENDENCY}_OPTIONS ${OPTIONS}"
                    LOCKFILE "${LOCKFILE}"
                )
            else()
                set(LOCKFILE "${LOCKFILE}\nset(${DEPENDENCY}_OPTIONS ${OPTIONS})")
            endif()
        endif()

        if(DEFINED LOCK_EXPORTS)
            list(JOIN LOCK_EXPORTS " " EXPORTS)
            string(REPLACE "${CMAKE_DEPENDENCY_DESTINATION}/" "" EXPORTS "${EXPORTS}")
            if(LOCKFILE MATCHES "set\\(${DEPENDENCY}_EXPORTS .*\\)")
                string(REGEX REPLACE
                    "${DEPENDENCY}_EXPORTS [^)]*" "${DEPENDENCY}_EXPORTS ${EXPORTS}"
                    LOCKFILE "${LOCKFILE}"
                )
            else()
                string(REPLACE "${CMAKE_DEPENDENCY_DESTINATION}/" "" EXPORTS "${EXPORTS}")
                set(LOCKFILE "${LOCKFILE}\nset(${DEPENDENCY}_EXPORTS ${EXPORTS})")
            endif()
        endif()

        file(WRITE ${CMAKE_LOCKFILE} "${LOCKFILE}")
    endif()

    return()
endfunction()

function(reset_lockfile_variables DEPENDENCY)
    if(NOT EXISTS ${CMAKE_DEPENDENCY_MANIFEST}/${DEPENDENCY}.cmake)
        status(ERROR MESSAGE "Unknown dependency: ${DEPENDENCY}")
        message(FATAL_ERROR "")
    endif()

    set(${DEPENDENCY}_HASH "" PARENT_SCOPE)
    set(${DEPENDENCY}_OPTIONS "" PARENT_SCOPE)
    set(${DEPENDENCY}_SYSTEM "" PARENT_SCOPE)
    set(${DEPENDENCY}_CONFIGURATION "" PARENT_SCOPE)
    set(${DEPENDENCY}_EXPORTS "" PARENT_SCOPE)

    return()
endfunction()

#############################################################
############# Dependency manipulation functions #############
#############################################################

function(get_dependencies)
    cmake_parse_arguments(PARSE_ARGV 0
        "DEPENDENCY"
        ""
        "OUTPUT"
        ""
    )

    if(NOT DEFINED DEPENDENCY_OUTPUT)
        set(DEPENDENCY_OUTPUT DEPENDENCIES)
    endif()

    file(GLOB TMP "${CMAKE_DEPENDENCY_MANIFEST}/*.cmake")
    string(REGEX REPLACE "(${CMAKE_DEPENDENCY_MANIFEST}/|.cmake)" ""
        TMP "${TMP}"
    )

    macro(sort_dependencies DEPS)
        foreach(DEPENDENCY ${DEPS})
            if(DEPENDENCY IN_LIST GRAPH)
                continue()
            endif()

            unset(DEPENDS)

            include(${CMAKE_DEPENDENCY_MANIFEST}/${DEPENDENCY}.cmake)

            if(DEFINED DEPENDS)
                sort_dependencies(${DEPENDS})
            endif()

            list(APPEND GRAPH "${DEPENDENCY}")
            unset(DEPENDS)
        endforeach()
    endmacro()

    sort_dependencies("${TMP}")

    set(${DEPENDENCY_OUTPUT} "${GRAPH}" PARENT_SCOPE)

    return()
endfunction()

function(get_dependency_properties DEPENDENCY)
    cmake_parse_arguments(PARSE_ARGV 1
        "DEPENDENCY"
        ""
        "PREFIX"
        "FROM"
    )

    if(NOT DEPENDENCY IN_LIST DEPENDENCY_FROM)
        status(ERROR MESSAGE "Unknown dependency: ${DEPENDENCY}")
        return()
    endif()

    if(NOT DEFINED DEPENDENCY_PREFIX)
        set(DEPENDENCY_PREFIX "DEPENDENCY")
    endif()

    unset(URL PARENT_SCOPE)
    unset(OPTIONS PARENT_SCOPE)
    unset(SYSTEM PARENT_SCOPE)
    unset(CONFIGURATION PARENT_SCOPE)
    unset(ENTRYPOINT PARENT_SCOPE)
    unset(COMMAND PARENT_SCOPE)
    unset(DISABLED PARENT_SCOPE)
    unset(CMAKE_USE_PRESET PARENT_SCOPE)
    unset(CMAKE_PRESET PARENT_SCOPE)
    unset(FILE PARENT_SCOPE)
    unset(VERSION PARENT_SCOPE)
    unset(COMPATIBILITY PARENT_SCOPE)

    include(${CMAKE_DEPENDENCY_MANIFEST}/${DEPENDENCY}.cmake)

    if(DISABLED)
        set(${DEPENDENCY_PREFIX}_DISABLED "${DISABLED}" PARENT_SCOPE)
        return()
    endif()

    if(NOT DEFINED SYSTEM)
        status(ERROR MESSAGE "Must define a build system for ${DEPENDENCY}. Set it via the SYSTEM variable")
    endif()

    if(NOT SYSTEM IN_LIST SUPPORTED_BUILD_SYSTEMS)
        list(JOIN SUPPORTED_BUILD_SYSTEMS " " SYSTEMS)
        status(ERROR MESSAGE "Unsupported build system: ${SYSTEM}. Expected one of ${SYSTEMS}")
    endif()

    if(NOT DEFINED CONFIGURATION)
        if(SYSTEM STREQUAL CMake)
            set(CONFIGURATION Release)
        elseif(SYSTEM STREQUAL Meson)
            set(CONFIGURATION release)
        endif()
    endif()

    if(SYSTEM STREQUAL CMake)
        if(NOT DEFINED COMMAND)
            set(COMMAND "${CMAKE_COMMAND}")
        endif()

        if(NOT DEFINED ENTRYPOINT)
            set(ENTRYPOINT ".")
        endif()

        if(CMAKE_USE_PRESET AND NOT DEFINED CMAKE_PRESET)
            set(CMAKE_PRESET default)
        endif()

        set(COMMAND_ARGUMENTS -B . -S )
    elseif(SYSTEM STREQUAL Meson)
        if(NOT DEFINED COMMAND)    
            find_program(MESON_COMMAND NAMES meson REQUIRED)
            set(COMMAND "${MESON_COMMAND}")
        endif()

        if(NOT DEFINED ENTRYPOINT)
            set(ENTRYPOINT ".")
        endif()
    elseif(SYSTEM STREQUAL Autoconf)
        set(CONFIGURATION None)

        if(NOT DEFINED COMMAND)
            find_program(MAKE_COMMAND NAMES make REQUIRED)
            set(COMMAND "${MAKE_COMMAND}")
        endif()

        if(NOT DEFINED ENTRYPOINT)
            set(ENTRYPOINT "..")
        endif() 
    endif()

    get_url_type(URL ${URL} OUTPUT URL_TYPE)

    if(URL_TYPE MATCHES Github)
        if(NOT DEFINED ID)
            status(ERROR MESSAGE "Dependency ${DEPENDENCY} does not specify a GitHub tag")
        endif()
    endif()

    if(DEFINED OPTIONS AND OPTIONS)
        foreach(OPTION "${OPTIONS}")
            if(OPTION MATCHES "([^=]+)=(.+)")
                set(NAME "${CMAKE_MATCH_1}")
                set(VALUE "${CMAKE_MATCH_2}")
            else()
                set(NAME "${OPTION}")
                set(VALUE "ON")
            endif()

            string(REPLACE ";" ":" VALUE "${VALUE}")

            if(NOT NAME IN_LIST NAMES)
                list(APPEND TMP "${NAME}=${VALUE}")
                list(APPEND NAMES "${NAME}")
            else()
                string(REGEX REPLACE "${NAME}=[^;]*(;)?" "${NAME}=${VALUE}\\1" TMP "${TMP}")
            endif()
        endforeach()
        
        list(SORT TMP)
        string(REPLACE "\"" "" OPTIONS "${OPTIONS}")
    endif()

    if(NOT DEFINED EXPORTS AND ${DEPENDENCY}_EXPORTS)
        set(EXPORTS "${${DEPENDENCY}_EXPORTS}")
    endif()

    if(NOT DEFINED LANGUAGES)
        set(LANGUAGES C CXX)
    endif()

    if(NOT SYSTEM STREQUAL CMake)
        if(NOT DEFINED VERSION)
            status(ERROR MESSAGE "Must specify a version for external dependencies" PREFIX DEPENDENCY)
        endif()

        if(NOT DEFINED COMPATIBILITY)
            set(COMPATIBILITY ExactVersion)
        endif()
    endif()

    set(${DEPENDENCY_PREFIX}_URL "${URL}" PARENT_SCOPE)
    set(${DEPENDENCY_PREFIX}_ID "${ID}" PARENT_SCOPE)
    set(${DEPENDENCY_PREFIX}_OPTIONS "${OPTIONS}" PARENT_SCOPE)
    set(${DEPENDENCY_PREFIX}_SYSTEM "${SYSTEM}" PARENT_SCOPE)
    set(${DEPENDENCY_PREFIX}_CONFIGURATION "${CONFIGURATION}" PARENT_SCOPE)
    set(${DEPENDENCY_PREFIX}_ENTRYPOINT "${ENTRYPOINT}" PARENT_SCOPE)
    set(${DEPENDENCY_PREFIX}_EXPORTS "${EXPORTS}" PARENT_SCOPE)
    set(${DEPENDENCY_PREFIX}_COMMAND "${COMMAND}" PARENT_SCOPE)
    set(${DEPENDENCY_PREFIX}_LANGUAGES "${LANGUAGES}" PARENT_SCOPE)
    set(${DEPENDENCY_PREFIX}_FILE "${FILE}" PARENT_SCOPE)
    set(${DEPENDENCY_PREFIX}_VERSION "${VERSION}" PARENT_SCOPE)
    set(${DEPENDENCY_PREFIX}_COMPATIBILITY "${COMPATIBILITY}" PARENT_SCOPE)

    # CMake specific variables
    set(${DEPENDENCY_PREFIX}_CMAKE_USE_PRESET "${CMAKE_USE_PRESET}" PARENT_SCOPE)
    set(${DEPENDENCY_PREFIX}_CMAKE_PRESET "${CMAKE_PRESET}" PARENT_SCOPE)
endfunction()

function(fetch_dependency)
    cmake_parse_arguments(PARSE_ARGV 0
        "FETCH"
        ""
        "DESTINATION;SOURCE;URL;ID"
        ""
    )

    if(DEFINED FETCH_SOURCE)
        if(IS_DIRECTORY "${FETCH_SOURCE}")
            cmake_path(GET FETCH_DESTINATION PARENT_PATH FETCH_DESTINATION)
        endif()

        file(COPY "${FETCH_SOURCE}" DESTINATION "${FETCH_DESTINATION}")
    elseif(DEFINED FETCH_URL)
        fetch_url(
            URL "${FETCH_URL}"
            ID "${FETCH_ID}"
            DESTINATION "${FETCH_DESTINATION}"
        )
    endif()

    return()
endfunction()

function(configure_dependency DEPENDENCY)
    cmake_parse_arguments(PARSE_ARGV 1
        "CONFIGURE"
        "IMPLICIT_VARIABLES"
        "SOURCE;DESTINATION"
        "FROM"
    )

    if(NOT CONFIGURE_IMPLICIT_VARIABLES)
        get_dependency_properties(${DEPENDENCY} FROM ${CONFIGURE_FROM} PREFIX DEPENDENCY)
    else()
        if(NOT DEPENDENCY IN_LIST CONFIGURE_FROM)
            status(ERROR MESSAGE "Unknown dependency ${DEPENDENCY}" PREFIX DEPENDENCY)
        endif()
    endif()

    if(NOT DEFINED CONFIGURE_SOURCE)
        set(CONFIGURE_SOURCE "${CMAKE_DEPENDENCY_SOURCE}/${DEPENDENCY}")
    endif()

    if(NOT DEFINED CONFIGURE_DESTINATION)
        set(CONFIGURE_DESTINATION "${CMAKE_DEPENDENCY_STAGE}/${DEPENDENCY}")
    endif()

    if(DEPENDENCY_SYSTEM STREQUAL CMake)
        foreach(OPTION IN LISTS DEPENDENCY_OPTIONS)
            if(OPTION MATCHES ";")
                string(REPLACE ";" "\;" OPTION "${OPTION}")
            endif()

            list(APPEND OPTIONS "-D${OPTION}")
        endforeach()

        set(CONFIGURE_COMMAND "${DEPENDENCY_COMMAND}")
        set(CONFIGURE_ARGUMENTS
            -Wno-dev --no-warn-unused-cli
            -DCMAKE_BUILD_TYPE=${DEPENDENCY_CONFIGURATION}
            -DCMAKE_INSTALL_PREFIX=${CMAKE_DEPENDENCY_DESTINATION}
            -DCMAKE_TOOLCHAIN_FILE=${CMAKE_TOOLCHAIN_FILE}
            ${OPTIONS}
            -B ${CONFIGURE_DESTINATION}
        )

        if(DEPENDENCY_CMAKE_USE_PRESET)
            list(APPEND CONFIGURE_ARGUMENTS "--preset ${DEPENDENCY_CMAKE_PRESET}")
        else()
            list(APPEND CONFIGURE_ARGUMENTS "-S ${DEPENDENCY_ENTRYPOINT}")
        endif()
    elseif(DEPENDENCY_SYSTEM STREQUAL Meson)
        foreach(OPTION IN LISTS DEPENDENCY_OPTIONS)
            if(OPTION MATCHES ";")
                string(REPLACE ";" "\;" OPTION "${OPTION}")
            endif()

            list(APPEND OPTIONS "-D${OPTION}")
        endforeach()

        set(CONFIGURE_COMMAND "${DEPENDENCY_COMMAND}")
        set(CONFIGURE_ARGUMENTS
            setup --reconfigure ${CONFIGURE_DESTINATION} ${DEPENDENCY_ENTRYPOINT}
            --prefix=${CMAKE_DEPENDENCY_DESTINATION} --buildtype=${DEPENDENCY_CONFIGURATION}
            ${OPTIONS}
        )
    elseif(DEPENDENCY_SYSTEM STREQUAL Autoconf)
        file(MAKE_DIRECTORY "${CONFIGURE_DESTINATION}")

        set(CONFIGURE_COMMAND "${CONFIGURE_SOURCE}/${DEPENDENCY_ENTRYPOINT}/configure")
        set(CONFIGURE_ARGUMENTS
            --prefix=${CMAKE_DEPENDENCY_DESTINATION}
            ${DEPENDENCY_OPTIONS}
        )

        set(CONFIGURE_SOURCE "${CONFIGURE_DESTINATION}")
    endif()

    status(INFO MESSAGE "Configuring ${DEPENDENCY}")
    execute_process(
        WORKING_DIRECTORY ${CONFIGURE_SOURCE}
        COMMAND ${CONFIGURE_COMMAND} ${CONFIGURE_ARGUMENTS}
        OUTPUT_QUIET
        ERROR_VARIABLE CONFIGURE_ERROR
    )

    if(CONFIGURE_ERROR)
        if(EXISTS "${CONFIGURE_DESTINATION}")
            file(REMOVE_RECURSE "${CONFIGURE_DESTINATION}")
        endif()
        status(ERROR MESSAGE "${CONFIGURE_ERROR}" PREFIX CONFIGURE)
    endif()

    return()
endfunction()

function(build_dependency DEPENDENCY)
    cmake_parse_arguments(PARSE_ARGV 1
        "BUILD"
        "ON_BUILD;IMPLICIT_VARIABLES"
        "SOURCE;DESTINATION"
        "FROM"
    )

    if(NOT BUILD_IMPLICIT_VARIABLES)
        get_dependency_properties(${DEPENDENCIES} FROM ${BUILD_FROM} PREFIX DEPENDENCY)
    else()
        if(NOT DEPENDENCY IN_LIST BUILD_FROM)
            status(ERROR MESSAGE "Unknown dependency ${DEPENDENCY}" PREFIX DEPENDENCY)
        endif()
    endif()

    if(NOT DEFINED BUILD_SOURCE)
        set(BUILD_SOURCE "${CMAKE_DEPENDENCY_STAGE}/${DEPENDENCY}")
    endif()

    if(NOT DEFINED BUILD_DESTINATION)
        set(BUILD_DESTINATION "${BUILD_SOURCE}")
    endif()

    if(DEPENDENCY_SYSTEM STREQUAL CMake)
        set(BUILD_COMMAND ${DEPENDENCY_COMMAND} --build .)
        set(BUILD_ARGUMENTS
            --config ${DEPENDENCY_CONFIGURATION}
            --parallel ${NPROC}
        )
    elseif(DEPENDENCY_SYSTEM STREQUAL Meson)
        set(BUILD_COMMAND ${DEPENDENCY_COMMAND} compile)
        set(BUILD_ARGUMENTS -j${NPROC})
    elseif(DEPENDENCY_SYSTEM STREQUAL Autoconf)
        set(BUILD_COMMAND ${DEPENDENCY_COMMAND})
        set(BUILD_ARGUMENTS -j${NPROC})
    endif()

    if(BUILD_ON_BUILD)
        status(INFO MESSAGE "Building ${DEPENDENCY}" OUTPUT BUILD_COMMENT)
        add_custom_command(
            OUTPUT ${BUILD_DESTINATION}/.build
            WORKING_DIRECTORY ${BUILD_SOURCE}
            VERBATIM COMMAND ${BUILD_COMMAND} ${BUILD_ARGUMENTS}
            USES_TERMINAL
            COMMENT "${BUILD_COMMENT}"
        )
    else()
        status(INFO MESSAGE "Building ${DEPENDENCY}")
        execute_process(
            WORKING_DIRECTORY ${BUILD_SOURCE}
            COMMAND ${BUILD_COMMAND} ${BUILD_ARGUMENTS}
            OUTPUT_QUIET
            ERROR_VARIABLE BUILD_ERROR
        )

        if(BUILD_ERROR)
            status(ERROR MESSAGE "${BUILD_ERROR}" PREFIX BUILD)
        endif()

        file(TOUCH ${BUILD_DESTINATION}/.build)
    endif()

    if(EXISTS ${BUILD_DESTINATION}/.build)    
        file(CHMOD ${BUILD_DESTINATION}/.build PERMISSIONS
            OWNER_READ
            GROUP_READ
            WORLD_READ
        )
    endif()

    return()
endfunction()

function(install_dependency DEPENDENCY)
    cmake_parse_arguments(PARSE_ARGV 1
        "INSTALL"
        "ON_BUILD;IMPLICIT_VARIABLES"
        "SOURCE;DESTINATION"
        "FROM;WATCH"
    )

    if(NOT INSTALL_IMPLICIT_VARIABLES)
        get_dependency_properties(${DEPENDENCIES} FROM ${INSTALL_FROM} PREFIX DEPENDENCY)
    else()
        if(NOT DEPENDENCY IN_LIST INSTALL_FROM)
            status(ERROR MESSAGE "Unknown dependency ${DEPENDENCY}" PREFIX DEPENDENCY)
        endif()
    endif()

    if(NOT DEFINED INSTALL_SOURCE)
        set(INSTALL_SOURCE "${CMAKE_DEPENDENCY_STAGE}/${DEPENDENCY}")
    endif()

    if(NOT DEFINED INSTALL_DESTINATION)
        set(INSTALL_DESTINATION "${CMAKE_DEPENDENCY_DESTINATION}")
    endif()

    if(NOT DEFINED INSTALL_WATCH)
        set(INSTALL_WATCH "${INSTALL_SOURCE}/.install")
    endif()

    if(DEPENDENCY_SYSTEM STREQUAL CMake)
        set(INSTALL_COMMAND ${DEPENDENCY_COMMAND} --install .)
        set(INSTALL_ARGUMENTS
            --config ${DEPENDENCY_CONFIGURATION} --parallel ${NPROC}
        )
    elseif(DEPENDENCY_SYSTEM STREQUAL Meson)
        set(INSTALL_COMMAND ${DEPENDENCY_COMMAND} install)
        set(INSTALL_ARGUMENTS --no-rebuild --only-changed)
    elseif(DEPENDENCY_SYSTEM STREQUAL Autoconf)
        set(INSTALL_COMMAND ${DEPENDENCY_COMMAND} install)
        set(INSTALL_ARGUMENTS DESTDIR=${INSTALL_SOURCE}/.install)
    endif()

    foreach(WATCH IN LISTS INSTALL_WATCH)
        if(NOT IS_ABSOLUTE ${WATCH})
            string(PREPEND WATCH "${CMAKE_DEPENDENCY_DESTINATION}/")
        endif()
        list(APPEND NORMALIZED_WATCH "${WATCH}")
    endforeach()
    set(INSTALL_WATCH "${NORMALIZED_WATCH}")

    if(INSTALL_ON_BUILD)
        status(INFO MESSAGE "Installing ${DEPENDENCY}" OUTPUT INSTALL_COMMENT)
        add_custom_command(
            OUTPUT ${INSTALL_WATCH}
            WORKING_DIRECTORY ${INSTALL_SOURCE}
            VERBATIM COMMAND ${INSTALL_COMMAND} ${INSTALL_ARGUMENTS}
            USES_TERMINAL
            COMMENT "${INSTALL_COMMENT}"
            DEPENDS ${INSTALL_SOURCE}/.build
        )
    else()
        status(INFO MESSAGE "Installing ${DEPENDENCY}")
        execute_process(
            WORKING_DIRECTORY ${INSTALL_SOURCE}
            COMMAND ${INSTALL_COMMAND} ${INSTALL_ARGUMENTS}
            OUTPUT_QUIET
            ERROR_VARIABLE INSTALL_ERROR
        )

        if(INSTALL_ERROR)
            status(ERROR MESSAGE "${INSTALL_ERROR}" PREFIX INSTALL)
        endif()

        foreach(WATCH IN LISTS INSTALL_WATCH)
            if(NOT EXISTS ${WATCH})
                file(TOUCH "${WATCH}")
            endif()
        endforeach()
    endif()

    return()
endfunction()

function(retrieve_dependency_exports DEPENDENCY)
    cmake_parse_arguments(PARSE_ARGV 1
        "RETRIEVE"
        "IMPLICIT_VARIABLES"
        "SOURCE;OUTPUT"
        "FROM"
    )

    if(NOT RETRIEVE_IMPLICIT_VARIABLES)
        get_dependency_properties(${DEPENDENCY} FROM ${RETRIEVE_FROM} PREFIX DEPENDENCY)
    else()
        if(NOT DEPENDENCY IN_LIST RETRIEVE_FROM)
            status(ERROR MESSAGE "Unknown dependency ${DEPENDENCY}" PREFIX DEPENDENCY)
        endif()
    endif()

    if(NOT DEFINED RETRIEVE_SOURCE)
        set(RETRIEVE_SOURCE "${CMAKE_DEPENDENCY_STAGE}/${DEPENDENCY}")
    endif()

    status(INFO MESSAGE "Retrieving exports of ${DEPENDENCY}")
    if(DEPENDENCY_SYSTEM STREQUAL CMake)
        file(STRINGS
            ${RETRIEVE_SOURCE}/install_manifest.txt
            ${RETRIEVE_OUTPUT}
        ) 
    elseif(DEPENDENCY_SYSTEM STREQUAL Meson)
        file(STRINGS
            ${RETRIEVE_SOURCE}/meson-logs/install-log.txt
            STRINGS
        )

        foreach(STRING IN LISTS STRINGS)
            if(STRING MATCHES "^#.*$")
                continue()
            endif()

            list(APPEND ${RETRIEVE_OUTPUT} "${STRING}")
        endforeach()
    elseif(DEPENDENCY_SYSTEM STREQUAL Autoconf)
        file(GLOB_RECURSE ${RETRIEVE_OUTPUT} "${RETRIEVE_SOURCE}/.install/*")
    endif() 

    string(REPLACE "${CMAKE_DEPENDENCY_DESTINATION}/" "" ${RETRIEVE_OUTPUT} "${${RETRIEVE_OUTPUT}}")

    return(PROPAGATE ${RETRIEVE_OUTPUT})
endfunction()

function(compute_dependency_hash DEPENDENCY)
    cmake_parse_arguments(PARSE_ARGV 1
        "DEPENDENCY"
        ""
        "OUTPUT"
        ""
    )

    if(NOT EXISTS ${CMAKE_DEPENDENCY_MANIFEST}/${DEPENDENCY}.cmake)
        status(ERROR MESSAGE "Unknown dependency: ${DEPENDENCY}")
        return()
    else()
        include(${CMAKE_DEPENDENCY_MANIFEST}/${DEPENDENCY}.cmake)
    endif()

    if(URL MATCHES "https://github.com")
        if(NOT DEFINED ID)
            status(ERROR MESSAGE "Dependency ${DEPENDENCY} does not specify a GitHub tag")
            message(FATAL_ERROR "")
        endif()

        string(APPEND URL "/archive/refs/tags/${ID}")
    endif()

    string(SHA512 ${DEPENDENCY_OUTPUT} "${URL}")

    return(PROPAGATE ${DEPENDENCY_OUTPUT})
endfunction()

