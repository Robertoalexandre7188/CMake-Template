############# External system adapter functions #############
#############################################################

function(write_system_adapter DEPENDENCY)
    cmake_parse_arguments(PARSE_ARGV 1
        "ADAPTER"
        ""
        "VERSION;COMPATIBILITY"
        "LANGUAGES;EXPORTS"
    )

    include(CMakePackageConfigHelpers)

    execute_process(
        COMMAND ${CMAKE_COMMAND}
        --log-level=VERBOSE
        -DCMAKE_DEPENDENCIES_SYSTEM_ADAPTER=ON -P ${CMAKE_CURRENT_LIST_FILE}
        ERROR_VARIABLE ADAPTER
    )

    set(CMAKE_TARGET_SYSTEM_NAME "${CMAKE_SYSTEM_NAME}")

    if(LINUX)
        set(CMAKE_HOST_TARGET "CMAKE_HOST_LINUX")
    elseif(APPLE)
        set(CMAKE_HOST_TARGET "CMAKE_HOST_APPLE")
    elseif(WIN32)
        set(CMAKE_HOST_TARGET "CMAKE_HOST_WIN32")
    elseif(BSD)
        set(CMAKE_HOST_TARGET "CMAKE_HOST_BSD")
    elseif(UNIX)
        set(CMAKE_HOST_TARGET "CMAKE_HOST_UNIX")
    endif()

    set(DEPENDENCY_LANGUAGES "${ADAPTER_LANGUAGES}")
    set(DEPENDENCY_EXPORTS "${ADAPTER_EXPORTS}")

    file(CONFIGURE
        OUTPUT ${CMAKE_DEPENDENCY_DESTINATION}/${CMAKE_INSTALL_LIBDIR}/cmake/${DEPENDENCY}Config.cmake
        CONTENT "${ADAPTER}"
        @ONLY
    )

    write_basic_package_version_file(
        ${CMAKE_DEPENDENCY_DESTINATION}/${CMAKE_INSTALL_LIBDIR}/cmake/${DEPENDENCY}ConfigVersion.cmake
        VERSION ${ADAPTER_VERSION}
        COMPATIBILITY ${ADAPTER_COMPATIBILITY}
    )

    return()
endfunction()

#############################################################
#############################################################
#############################################################

if(EXISTS ${CMAKE_LOCKFILE})
    include(${CMAKE_LOCKFILE})
endif()

get_dependencies(OUTPUT DEPENDENCIES)

foreach(DEPENDENCY IN LISTS DEPENDENCIES)
    set(CMAKE_CURRENT_DEPENDENCY_STAGE "${CMAKE_DEPENDENCY_STAGE}/${DEPENDENCY}")
    set(CMAKE_CURRENT_DEPENDENCY_SOURCE "${CMAKE_DEPENDENCY_SOURCE}/${DEPENDENCY}")

    get_dependency_properties(${DEPENDENCY} FROM ${DEPENDENCIES})

    if(DEPENDENCY_DISABLED)
        continue()
    endif()

    compare_lockfile_values(${DEPENDENCY} HASH OUTPUT SHOULD_UPDATE)

    if(SHOULD_UPDATE OR NOT EXISTS ${CMAKE_CURRENT_DEPENDENCY_SOURCE})
        reset_lockfile_variables(${DEPENDENCY})

        status(INFO MESSAGE "Fetching ${DEPENDENCY} at ${DEPENDENCY_URL}")
        if(DEFINED DEPENDENCY_FILE)
            fetch_dependency(
                SOURCE ${DEPENDENCY_FILE}
                DESTINATION ${CMAKE_CURRENT_DEPENDENCY_SOURCE}
            )
        elseif(DEFINED DEPENDENCY_URL)
            fetch_dependency(
                URL ${DEPENDENCY_URL}
                ID ${DEPENDENCY_ID}
                DESTINATION ${CMAKE_CURRENT_DEPENDENCY_SOURCE}
            )
        endif()

        update_lockfile(${DEPENDENCY} URL ${DEPENDENCY_URL})
    endif()

    status(INFO MESSAGE "Configuring ${DEPENDENCY}" OUTPUT CONFIGURE_COMMENT)
    status(INFO MESSAGE "Building ${DEPENDENCY}" OUTPUT BUILD_COMMENT)
    status(INFO MESSAGE "Installing ${DEPENDENCY}" OUTPUT INSTALL_COMMENT)

    compare_lockfile_values(${DEPENDENCY}
        SYSTEM CONFIGURATION OPTIONS
        OUTPUT SHOULD_UPDATE
    )

    if(SHOULD_UPDATE)
        if(EXISTS "${CMAKE_CURRENT_DEPENDENCY_STAGE}")
            file(REMOVE_RECURSE "${CMAKE_CURRENT_DEPENDENCY_STAGE}")
        endif()

        configure_dependency(${DEPENDENCY} FROM ${DEPENDENCIES}
            SOURCE ${CMAKE_CURRENT_DEPENDENCY_SOURCE}
            DESTINATION ${CMAKE_CURRENT_DEPENDENCY_STAGE}
            IMPLICIT_VARIABLES
        )

        if(CONFIGURE_ERROR)
            file(REMOVE_RECURSE "${CMAKE_CURRENT_DEPENDENCY_STAGE}")
            status(ERROR MESSAGE "${CONFIGURE_ERROR}" PREFIX CONFIGURE)
        endif()

        update_lockfile(${DEPENDENCY}
            SYSTEM ${DEPENDENCY_SYSTEM}
            CONFIGURATION ${DEPENDENCY_CONFIGURATION}
            OPTIONS ${DEPENDENCY_OPTIONS}
        )
    endif()

    if(NOT ${DEPENDENCY}_EXPORTS)
        build_dependency(${DEPENDENCY} FROM ${DEPENDENCIES}
            SOURCE ${CMAKE_CURRENT_DEPENDENCY_STAGE}
            IMPLICIT_VARIABLES
        )

        install_dependency(${DEPENDENCY} FROM ${DEPENDENCIES}
            SOURCE ${CMAKE_CURRENT_DEPENDENCY_STAGE}
            DESTINATION ${CMAKE_DEPENDENCY_DESTINATION}
            IMPLICIT_VARIABLES
        )

        retrieve_dependency_exports(${DEPENDENCY} FROM ${DEPENDENCIES}
            SOURCE ${CMAKE_CURRENT_DEPENDENCY_STAGE}
            OUTPUT ${DEPENDENCY}_EXPORTS
            IMPLICIT_VARIABLES
        )

        if(NOT DEPENDENCY_SYSTEM STREQUAL CMake)
            write_system_adapter(${DEPENDENCY}
                LANGUAGES ${DEPENDENCY_LANGUAGES}
                EXPORTS ${${DEPENDENCY}_EXPORTS}
                COMPATIBILITY ${DEPENDENCY_COMPATIBILITY}
                VERSION ${DEPENDENCY_VERSION}
            )

            list(APPEND ${DEPENDENCY}_EXPORTS
                ${CMAKE_INSTALL_LIBDIR}/cmake/${DEPENDENCY}Config.cmake
                ${CMAKE_INSTALL_LIBDIR}/cmake/${DEPENDENCY}ConfigVersion.cmake
            )
        endif()

        update_lockfile(${DEPENDENCY} EXPORTS ${${DEPENDENCY}_EXPORTS})
    endif()

    build_dependency(${DEPENDENCY} FROM ${DEPENDENCIES}
        SOURCE ${CMAKE_CURRENT_DEPENDENCY_STAGE}
        ON_BUILD IMPLICIT_VARIABLES
    )

    install_dependency(${DEPENDENCY} FROM ${DEPENDENCIES}
        SOURCE ${CMAKE_CURRENT_DEPENDENCY_STAGE}
        DESTINATION ${CMAKE_DEPENDENCY_DESTINATION}
        WATCH ${${DEPENDENCY}_EXPORTS}
        ON_BUILD IMPLICIT_VARIABLES
    )

    foreach(EXPORT IN LISTS ${DEPENDENCY}_EXPORTS)
        if(NOT IS_ABSOLUTE ${EXPORT})
            string(PREPEND EXPORT "${CMAKE_DEPENDENCY_DESTINATION}/")
        endif()
        list(APPEND EXPORTS "${EXPORT}")
    endforeach()
    set(${DEPENDENCY}_EXPORTS "${EXPORTS}")

    add_custom_target(${DEPENDENCY} ALL DEPENDS ${${DEPENDENCY}_EXPORTS})
endforeach()

endblock()
